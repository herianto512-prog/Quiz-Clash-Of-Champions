<script>
const questions = [
{type:'mc',level:'Easy',p:100,q:'Apa yang dimaksud dengan data pribadi?',o:['Informasi yang dapat mengidentifikasi seseorang','Semua berita di internet','Hanya nama aplikasi','Informasi yang selalu boleh dibagikan'],a:0,e:'Data pribadi adalah informasi tentang seseorang yang dapat digunakan untuk mengenali atau mengidentifikasinya, misalnya nama lengkap, alamat, nomor telepon, dan data identitas.'},
{type:'mc',level:'Easy',p:100,q:'Manakah contoh kata sandi yang paling kuat?',o:['12345678','password','Budi2009','K7!mP#92zQ'],a:3,e:'Kata sandi kuat memiliki kombinasi huruf besar-kecil, angka, dan simbol, cukup panjang, serta tidak mudah ditebak.'},
{type:'mc',level:'Easy',p:100,q:'Apa tindakan yang tepat ketika menerima tautan mencurigakan dari orang tidak dikenal?',o:['Langsung membukanya','Memeriksa pengirim dan tidak mengeklik tautan','Meneruskan ke semua teman','Mengisi data agar tahu isinya'],a:1,e:'Tautan mencurigakan dapat mengarah ke phishing atau malware. Periksa sumbernya dan jangan memasukkan informasi pribadi.'},
{type:'mc',level:'Easy',p:100,q:'Mengapa kita tidak boleh membagikan PIN kepada teman?',o:['Agar PIN terlihat keren','Karena PIN melindungi akses akun atau perangkat','Supaya teman tidak lupa','Agar internet lebih cepat'],a:1,e:'PIN adalah rahasia autentikasi. Membagikannya memungkinkan orang lain mengakses akun atau perangkat.'},
{type:'mc',level:'Easy',p:100,q:'Informasi manakah yang sebaiknya tidak diunggah secara terbuka?',o:['Foto pemandangan umum','Jadwal pelajaran tanpa identitas','Alamat rumah dan nomor telepon pribadi','Poster kegiatan sekolah umum'],a:2,e:'Alamat rumah dan nomor telepon merupakan data pribadi yang dapat disalahgunakan jika tersebar.'},
{type:'mc',level:'Easy',p:100,q:'Apa arti logout setelah menggunakan akun di komputer umum?',o:['Menghapus internet','Keluar dari akun agar tidak dapat diakses pengguna berikutnya','Mematikan monitor','Mengganti nama akun'],a:1,e:'Logout mengakhiri sesi akun sehingga orang lain yang memakai perangkat tidak langsung memperoleh akses.'},
{type:'mc',level:'Easy',p:100,q:'Apa yang dimaksud dengan privasi digital?',o:['Kebebasan mengakses semua akun','Perlindungan kendali atas informasi pribadi di lingkungan digital','Kecepatan mengunduh file','Menghapus semua aplikasi'],a:1,e:'Privasi digital berkaitan dengan bagaimana data pribadi dikumpulkan, digunakan, disimpan, dan dibagikan.'},
{type:'mc',level:'Easy',p:100,q:'Jika teman meminta kata sandi akun gim milikmu, tindakan paling aman adalah ...',o:['Memberikannya jika teman dekat','Mengirimkannya lewat komentar','Menolak membagikan kata sandi','Menuliskannya di grup kelas'],a:2,e:'Kata sandi tidak boleh dibagikan. Gunakan fitur berbagi resmi bila memang diperlukan, bukan memberikan kredensial.'},
{type:'mc',level:'Easy',p:100,q:'Apa fungsi utama kunci layar pada ponsel?',o:['Membuat baterai penuh','Mencegah akses tanpa izin','Memperbesar kapasitas memori','Menghapus virus otomatis'],a:1,e:'Kunci layar dengan PIN, pola, kata sandi, atau biometrik membantu mencegah orang lain membuka perangkat.'},
{type:'mc',level:'Easy',p:100,q:'Manakah kebiasaan aman saat memakai Wi-Fi publik?',o:['Mengakses semua akun penting tanpa perlindungan','Membagikan kata sandi kepada orang sekitar','Menghindari transaksi sensitif dan memakai koneksi aman','Mematikan kunci layar'],a:2,e:'Wi-Fi publik dapat memiliki risiko penyadapan. Hindari aktivitas sensitif dan pastikan situs menggunakan HTTPS.'},

{type:'mc',level:'Medium',p:200,q:'Apa yang dimaksud dengan autentikasi dua faktor (2FA)?',o:['Memakai dua nama pengguna','Verifikasi identitas dengan dua jenis bukti','Mengganti kata sandi dua kali sehari','Membuat dua akun yang sama'],a:1,e:'2FA menambahkan lapisan keamanan, misalnya kata sandi ditambah kode sekali pakai atau persetujuan pada perangkat.'},
{type:'mc',level:'Medium',p:200,q:'Pesan mengaku dari bank meminta kata sandi melalui tautan. Ini kemungkinan merupakan ...',o:['Phishing','Backup','Enkripsi','Kompresi'],a:0,e:'Phishing adalah upaya menipu korban agar memberikan data rahasia melalui pesan atau situs palsu.'},
{type:'mc',level:'Medium',p:200,q:'Mengapa pembaruan sistem operasi penting untuk keamanan?',o:['Selalu menghapus seluruh file','Menutup celah keamanan dan memperbaiki kerentanan','Membuat kata sandi tidak diperlukan','Menghilangkan kebutuhan antivirus'],a:1,e:'Pembaruan sering membawa perbaikan keamanan untuk menutup kerentanan yang dapat dimanfaatkan penyerang.'},
{type:'mc',level:'Medium',p:200,q:'Apa tujuan melakukan backup data secara berkala?',o:['Membuat data tersebar','Memiliki salinan untuk pemulihan jika data hilang atau rusak','Membagikan data ke publik','Mengurangi keamanan akun'],a:1,e:'Backup menyediakan salinan cadangan sehingga data dapat dipulihkan setelah kerusakan perangkat, kesalahan, atau serangan.'},
{type:'mc',level:'Medium',p:200,q:'Saat aplikasi meminta izin akses lokasi padahal tidak membutuhkannya, sebaiknya ...',o:['Selalu izinkan','Berikan semua izin','Tolak atau batasi izin yang tidak relevan','Hapus kata sandi'],a:2,e:'Terapkan prinsip minimisasi data dan izin seperlunya. Aplikasi hanya perlu memperoleh akses yang relevan dengan fungsinya.'},
{type:'mc',level:'Medium',p:200,q:'Apa perbedaan utama HTTP dan HTTPS?',o:['HTTPS menambahkan enkripsi koneksi melalui TLS','HTTP selalu lebih aman','HTTPS tidak memakai jaringan','Tidak ada perbedaan'],a:0,e:'HTTPS melindungi komunikasi antara browser dan situs dengan TLS, sehingga data lebih sulit disadap atau diubah saat transit.'},
{type:'mc',level:'Medium',p:200,q:'Jejak digital adalah ...',o:['Bekas sepatu di lantai','Rekaman aktivitas yang ditinggalkan saat menggunakan layanan digital','Kode untuk mempercepat komputer','File yang selalu terhapus otomatis'],a:1,e:'Jejak digital mencakup unggahan, komentar, pencarian, dan aktivitas online lain yang dapat tersimpan atau tersebar.'},
{type:'mc',level:'Medium',p:200,q:'Mengapa menggunakan kata sandi berbeda untuk setiap akun lebih aman?',o:['Agar mudah lupa','Jika satu akun bocor, akun lain tidak otomatis memakai sandi yang sama','Agar perangkat lebih ringan','Supaya akun tidak perlu diverifikasi'],a:1,e:'Kata sandi unik membatasi dampak kebocoran. Pengelola kata sandi dapat membantu menyimpan sandi yang berbeda.'},
{type:'mc',level:'Medium',p:200,q:'Apa tindakan pertama jika akun media sosial diduga diretas?',o:['Membiarkannya','Segera ganti kata sandi dari perangkat aman dan amankan metode pemulihan','Membagikan kode OTP','Menghapus semua kontak'],a:1,e:'Amankan akun melalui kanal resmi, ganti kata sandi, keluar dari sesi asing, aktifkan 2FA, dan periksa data pemulihan.'},
{type:'mc',level:'Medium',p:200,q:'Apa fungsi enkripsi?',o:['Mengubah data menjadi bentuk yang hanya dapat dibaca dengan kunci yang sesuai','Menghapus data permanen','Mempercepat pengisian baterai','Membuat akun anonim otomatis'],a:0,e:'Enkripsi mengubah informasi menjadi bentuk tersandi agar pihak tanpa kunci yang tepat tidak dapat membacanya.'},

{type:'mc',level:'Hard',p:300,q:'Sebuah sekolah menyimpan data siswa. Prinsip minimisasi data berarti sekolah sebaiknya ...',o:['Mengumpulkan semua informasi yang mungkin berguna','Mengumpulkan hanya data yang diperlukan untuk tujuan yang jelas','Membagikan data ke semua pihak','Menyimpan data tanpa batas waktu'],a:1,e:'Minimisasi data berarti membatasi pengumpulan pada data yang relevan dan diperlukan, bukan mengumpulkan sebanyak mungkin.'},
{type:'mc',level:'Hard',p:300,q:'Mengapa kode OTP tidak boleh diberikan kepada siapa pun, termasuk orang yang mengaku petugas?',o:['OTP hanya berlaku saat siang','OTP dapat menjadi bukti verifikasi untuk mengambil alih akses akun','OTP adalah nama pengguna','OTP memperlambat internet'],a:1,e:'OTP adalah kode rahasia sekali pakai. Penipu dapat memakainya untuk melewati proses verifikasi dan mengambil alih akun.'},
{type:'mc',level:'Hard',p:300,q:'Apa risiko utama menggunakan satu kata sandi yang sama pada banyak layanan?',o:['Credential stuffing: sandi bocor dicoba pada layanan lain','Semua akun otomatis terenkripsi','Perangkat menjadi lebih dingin','Tidak ada risiko jika sandi panjang'],a:0,e:'Penyerang dapat mencoba kombinasi kredensial yang bocor pada banyak situs. Sandi unik mengurangi risiko ini.'},
{type:'mc',level:'Hard',p:300,q:'Sebuah file penting dienkripsi ransomware. Strategi pemulihan yang paling tepat adalah ...',o:['Membayar tanpa pertimbangan','Memutus perangkat terdampak dari jaringan, melapor, dan memulihkan dari backup bersih','Mengirim file ke semua teman','Mematikan semua pengamanan'],a:1,e:'Isolasi membantu mencegah penyebaran. Laporkan insiden dan pulihkan dari cadangan yang diketahui bersih setelah sistem ditangani.'},
{type:'mc',level:'Hard',p:300,q:'Apa tujuan prinsip least privilege dalam pengelolaan akses?',o:['Semua pengguna menjadi administrator','Setiap pengguna mendapat hak akses minimum sesuai tugasnya','Semua akun memakai satu sandi','Akses tidak pernah ditinjau'],a:1,e:'Least privilege membatasi hak akses sesuai kebutuhan kerja sehingga dampak kesalahan atau kompromi akun lebih kecil.'},
{type:'mc',level:'Hard',p:300,q:'Mengapa persetujuan pengguna penting sebelum data pribadinya dikumpulkan atau dibagikan?',o:['Agar data bisa dijual bebas','Agar pengguna memahami tujuan dan memberi persetujuan secara sadar sesuai aturan','Agar aplikasi tidak perlu aman','Agar semua data menjadi publik'],a:1,e:'Persetujuan yang bermakna membantu pengguna memahami tujuan pemrosesan dan mengendalikan penggunaan data sesuai ketentuan yang berlaku.'},
{type:'mc',level:'Hard',p:300,q:'Apa langkah yang paling tepat untuk mengurangi risiko kebocoran data saat mengirim dokumen sensitif?',o:['Mengirim tautan publik tanpa batas','Memakai kanal aman, membatasi penerima, dan memberi akses seperlunya','Mengunggahnya ke komentar publik','Mengirim kata sandi di grup terbuka'],a:1,e:'Gunakan kanal tepercaya, enkripsi bila tersedia, pembatasan akses, dan verifikasi penerima sebelum mengirim.'},
{type:'mc',level:'Hard',p:300,q:'Mengapa log aktivitas penting dalam keamanan sistem?',o:['Mencatat aktivitas untuk membantu audit dan investigasi insiden','Menghapus seluruh jejak digital','Menggantikan semua kontrol akses','Membuat data tidak perlu dicadangkan'],a:0,e:'Log membantu mengetahui siapa melakukan apa dan kapan, sehingga anomali dapat dianalisis dan insiden ditelusuri.'},
{type:'mc',level:'Hard',p:300,q:'Apa yang dimaksud rekayasa sosial (social engineering)?',o:['Membangun jaringan sosial','Manipulasi psikologis agar korban mengungkapkan informasi atau melakukan tindakan tertentu','Memperbaiki perangkat keras','Mengenkripsi jaringan'],a:1,e:'Social engineering mengeksploitasi kepercayaan, rasa takut, atau urgensi untuk memanipulasi korban, bukan semata-mata kelemahan teknis.'},
{type:'mc',level:'Hard',p:300,q:'Sebuah layanan meminta tanggal lahir lengkap, alamat, dan nomor identitas padahal hanya untuk kuis sederhana. Sikap paling kritis adalah ...',o:['Mengisi semua data agar bisa bermain','Mempertanyakan kebutuhan, membaca kebijakan privasi, dan tidak memberi data berlebihan','Memakai data teman','Membagikan data di media sosial'],a:1,e:'Periksa apakah data benar-benar diperlukan dan bagaimana digunakan. Hindari memberikan data sensitif untuk tujuan yang tidak sebanding.'}
];

const written = [
{type:'written',level:'Easy',p:200,q:'Sebutkan satu contoh data pribadi yang perlu dijaga kerahasiaannya.',a:['alamat rumah','nomor telepon','nomor induk kependudukan','nik','nomor ktp','kata sandi','password','pin','tanggal lahir','nomor rekening'],e:'Contohnya alamat rumah, nomor telepon, NIK, kata sandi, PIN, atau nomor rekening. Data tersebut perlu dijaga agar tidak disalahgunakan.'},
{type:'written',level:'Easy',p:200,q:'Apa istilah untuk pesan atau situs palsu yang bertujuan mencuri informasi rahasia?',a:['phishing','pishing'],e:'Phishing adalah penipuan yang menyamar sebagai pihak tepercaya untuk mencuri informasi seperti kata sandi atau OTP.'},
{type:'written',level:'Easy',p:200,q:'Apa tindakan yang dilakukan untuk keluar dari akun setelah selesai menggunakan komputer bersama?',a:['logout','log out','keluar akun'],e:'Logout mengakhiri sesi akun agar pengguna berikutnya tidak dapat melanjutkan akses ke akun kita.'},
{type:'written',level:'Medium',p:200,q:'Tuliskan kepanjangan singkatan 2FA.',a:['two factor authentication','two-factor authentication','autentikasi dua faktor','otentikasi dua faktor'],e:'2FA adalah Two-Factor Authentication atau autentikasi dua faktor, yaitu verifikasi dengan dua jenis bukti.'},
{type:'written',level:'Medium',p:200,q:'Apa istilah untuk salinan cadangan data yang dibuat agar data dapat dipulihkan?',a:['backup','back up','pencadangan','cadangan data'],e:'Backup atau pencadangan adalah salinan data yang disimpan untuk pemulihan jika data utama hilang atau rusak.'},
{type:'written',level:'Medium',p:200,q:'Apa nama teknologi yang mengubah data menjadi bentuk tersandi agar tidak mudah dibaca pihak lain?',a:['enkripsi','encryption'],e:'Enkripsi mengubah data menjadi bentuk tersandi dan hanya dapat dibaca kembali dengan kunci yang sesuai.'},
{type:'written',level:'Hard',p:200,q:'Apa istilah prinsip pemberian hak akses minimum sesuai kebutuhan pekerjaan?',a:['least privilege','prinsip least privilege','hak akses minimum','akses minimum'],e:'Least privilege membatasi setiap akun pada hak minimum yang dibutuhkan untuk menjalankan tugas.'},
{type:'written',level:'Hard',p:200,q:'Apa nama serangan ketika penjahat mencoba kata sandi bocor pada banyak layanan lain?',a:['credential stuffing'],e:'Credential stuffing adalah percobaan masuk otomatis menggunakan kombinasi nama pengguna dan kata sandi yang pernah bocor.'},
{type:'written',level:'Hard',p:200,q:'Apa istilah untuk rekaman aktivitas yang ditinggalkan seseorang ketika menggunakan internet?',a:['jejak digital','digital footprint'],e:'Jejak digital adalah rekaman aktivitas online, seperti unggahan, komentar, pencarian, dan interaksi digital.'},
{type:'written',level:'Hard',p:200,q:'Apa istilah untuk manipulasi psikologis agar seseorang membocorkan data atau melakukan tindakan berisiko?',a:['rekayasa sosial','social engineering'],e:'Rekayasa sosial memanfaatkan kepercayaan, emosi, atau tekanan agar korban memberikan informasi atau melakukan tindakan tertentu.'}
];

let scores={A:0,B:0},turn='A',current=null,timerId=null,timeLeft=0,soundOn=true,used=new Set(),currentExplanation='';
const all=[...questions,...written];
function showScreen(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));document.getElementById(id).classList.add('active');window.scrollTo(0,0)}
function speak(text){if(!soundOn||!('speechSynthesis'in window))return;speechSynthesis.cancel();let u=new SpeechSynthesisUtterance(text);u.lang='id-ID';u.rate=.94;u.pitch=1.03;speechSynthesis.speak(u)}
function toggleSound(){soundOn=!soundOn;document.getElementById('soundToggle').textContent=soundOn?'🔊 Suara: Aktif':'🔇 Suara: Mati';if(!soundOn&&'speechSynthesis'in window)speechSynthesis.cancel();else speak('Audio pengisi suara diaktifkan. Selamat bertanding!')}
function startGame(){showScreen('guide');speak('Selamat datang, para champion! Kalian berada di arena Clash of Champions Informatika kelas 9 bersama Bapak Herianto Simorangkir, Sarjana Komputer. Hari ini kita akan menguji kemampuan tentang Manajemen Keamanan Data dan Perlindungan Privasi. Siapkan strategi terbaik, jaga kekompakan, dan jadilah juara yang cerdas serta bertanggung jawab di dunia digital!');setTimeout(()=>{if(document.getElementById('guide').classList.contains('active')){showScreen('arena');speak('Pertandingan mempertemukan Tim Alpha dan Tim Beta. Pilih kategori Easy bernilai seratus poin, Medium dua ratus poin, atau Hard tiga ratus poin. Setiap soal memiliki batas waktu. Jawaban benar menambah poin. Setelah menjawab, simak pembahasan. Tim dengan skor tertinggi akan menjadi Champion!') }},9000)}
function setTurn(t){turn=t;document.getElementById('turnA').style.outline=t==='A'?'3px solid white':'none';document.getElementById('turnB').style.outline=t==='B'?'3px solid white':'none';}
function buildBoard(){let board=document.getElementById('board');board.innerHTML='<div class="board-head">EASY<br>100 POIN</div><div class="board-head">MEDIUM<br>200 POIN</div><div class="board-head">HARD<br>300 POIN</div><div class="board-head">ISIAN<br>200 POIN</div><div class="board-head">STATUS</div>';let groups=[questions.filter(q=>q.level==='Easy'),questions.filter(q=>q.level==='Medium'),questions.filter(q=>q.level==='Hard'),written];for(let i=0;i<10;i++){for(let g=0;g<4;g++){let q=groups[g][i];if(!q){let blank=document.createElement('div');board.append(blank);continue}let idx=all.indexOf(q);let b=document.createElement('button');b.className='tile '+(used.has(idx)?'done':'');b.disabled=used.has(idx);b.innerHTML='<strong>'+(used.has(idx)?'✓':'SOAL '+(i+1))+'</strong><small>'+(used.has(idx)?'Selesai':q.p+' poin')+'</small>';b.onclick=()=>openQuestion(idx);board.append(b)}let status=document.createElement('div');status.className='board-head';status.style.background='#101b30';status.textContent='BARIS '+(i+1);board.append(status)}}
function openQuestion(idx){if(used.has(idx))return;current=idx;let q=all[idx];showScreen('play');document.getElementById('qCategory').textContent=q.level.toUpperCase()+' • '+q.p+' POIN'+(q.type==='written'?' • ISIAN':'');document.getElementById('qTeam').textContent=turn==='A'?'Tim Alpha':'Tim Beta';document.getElementById('qText').textContent=q.q;document.getElementById('feedback').classList.add('hidden');document.getElementById('afterActions').style.display='none';document.getElementById('writtenArea').classList.toggle('hidden',q.type!=='written');document.getElementById('options').innerHTML='';if(q.type==='mc'){q.o.forEach((op,i)=>{let b=document.createElement('button');b.className='option';b.textContent=String.fromCharCode(65+i)+'. '+op;b.onclick=()=>checkMC(i);document.getElementById('options').append(b)})}document.getElementById('writtenAnswer').value='';timeLeft=q.level==='Easy'?30:q.level==='Medium'?45:60;document.getElementById('timer').textContent='⏱ '+timeLeft;clearInterval(timerId);timerId=setInterval(()=>{timeLeft--;document.getElementById('timer').textContent='⏱ '+timeLeft;if(timeLeft<=0){clearInterval(timerId);if(q.type==='mc')finish(false,'Waktu habis.');else finish(false,'Waktu habis. Jawaban belum dikirim.')}},1000);speak('Soal untuk '+(turn==='A'?'Tim Alpha':'Tim Beta')+'. '+q.q)}
function checkMC(i){if(document.getElementById('afterActions').style.display==='flex')return;let q=all[current];document.querySelectorAll('.option').forEach((b,n)=>{b.disabled=true;if(n===q.a)b.classList.add('correct');if(n===i&&i!==q.a)b.classList.add('wrong')});finish(i===q.a,i===q.a?'Jawaban benar!':'Jawaban belum tepat.')}
function checkWritten(){let q=all[current],ans=document.getElementById('writtenAnswer').value.trim().toLowerCase();if(!ans){alert('Masukkan jawaban terlebih dahulu.');return}let ok=q.a.some(a=>ans===a||ans.includes(a));finish(ok,ok?'Jawaban diterima!':'Jawaban belum sesuai. Penilaian isian dapat dikonfirmasi guru.')}
function finish(correct,msg){clearInterval(timerId);let q=all[current];used.add(current);if(correct)scores[turn]+=q.p;else if(document.getElementById('penalty').checked)scores[turn]-=50;updateScores();currentExplanation=q.e;let fb=document.getElementById('feedback');fb.classList.remove('hidden');fb.innerHTML='<b>'+(correct?'✅ '+msg:'❌ '+msg)+'</b><br><br><b>Kunci jawaban:</b> '+(q.type==='mc'?q.o[q.a]:q.a[0])+'<br><br><b>Pembahasan singkat & konsep kunci:</b> '+q.e+'<br><br><b>Perolehan:</b> '+(correct?'+'+q.p:'0'+(document.getElementById('penalty').checked?' (−50 penalti)':''))+' poin';document.getElementById('afterActions').style.display='flex';document.querySelectorAll('.option').forEach(b=>b.disabled=true);speak((correct?'Jawaban benar. ':'Jawaban belum tepat. ')+'Kunci jawaban: '+(q.type==='mc'?q.o[q.a]:q.a[0])+'. Pembahasan. '+q.e)}
function updateScores(){document.getElementById('scoreA').textContent=scores.A;document.getElementById('scoreB').textContent=scores.B}
function backToBoard(){clearInterval(timerId);buildBoard();setTurn(turn==='A'?'B':'A');showScreen('arena');speak((turn==='A'?'Tim Alpha':'Tim Beta')+' mendapat giliran berikutnya. Silakan pilih soal.')}
function speakCurrentExplanation(){speak('Pembahasan singkat dan konsep kunci. '+currentExplanation)}
function showChampion(){clearInterval(timerId);let w=scores.A===scores.B?'HASIL SERI':scores.A>scores.B?'TIM ALPHA':'TIM BETA';document.getElementById('winnerName').textContent=w==='HASIL SERI'?'DRAW CHAMPIONS':w+' CHAMPION!';document.getElementById('finalScore').textContent='Alpha '+scores.A+' poin  —  Beta '+scores.B+' poin';document.getElementById('finalA').textContent=scores.A;document.getElementById('finalB').textContent=scores.B;document.getElementById('outroText').textContent=w==='HASIL SERI'?'Kedua tim memperoleh skor yang sama. Guru dapat memberikan satu soal tie-break.':'Selamat kepada '+w+'! Terima kasih kepada kedua tim atas semangat, kerja sama, dan sportivitasnya.';showScreen('champion');speakOutro()}
function speakOutro(){let w=scores.A===scores.B?'Hasil pertandingan seri.':scores.A>scores.B?'Selamat kepada Tim Alpha sebagai Champion!':'Selamat kepada Tim Beta sebagai Champion!';speak('Pertandingan telah selesai! '+w+' Untuk tim yang belum menang, kalian tetap luar biasa karena telah belajar dan berani mencoba. Terus lindungi data pribadi, berpikir kritis, dan gunakan teknologi dengan bijak. Sampai jumpa di tantangan berikutnya!')}
buildBoard();setTurn('A');
</script>
</body></html>
