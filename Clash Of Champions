  <h2 id="finalScore"></h2><p class="sub" id="outroText"></p>
  <div class="scoreboard"><div class="team alpha"><h3>🔷 TIM ALPHA</h3><div class="score" id="finalA">0</div></div><div class="team beta"><h3>🔺 TIM BETA</h3><div class="score" id="finalB">0</div></div></div>
  <div class="actions"><button onclick="speakOutro()">🔊 Putar Pengumuman</button><button class="secondary" onclick="location.reload()">MAIN LAGI</button></div>
 </div>
</section>

