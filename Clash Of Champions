<style>
:root{--bg:#080d1b;--panel:#111a31;--panel2:#182544;--gold:#ffd166;--cyan:#55d6ff;--pink:#ff5f8f;--green:#55e6a5;--muted:#a9b7d3;--white:#f7f9ff}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 50% 0%,#1b3260 0,#080d1b 52%);color:var(--white);font-family:Inter,Segoe UI,Arial,sans-serif;min-height:100vh}
button,input{font:inherit}button{cursor:pointer;border:0;border-radius:12px;padding:12px 18px;font-weight:800;color:#08101f;background:var(--gold);transition:.18s}button:hover{transform:translateY(-2px);filter:brightness(1.08)}button:disabled{opacity:.4;cursor:not-allowed;transform:none}
.secondary{background:#273654;color:var(--white);border:1px solid #435577}.cyan{background:var(--cyan)}.pink{background:var(--pink)}.green{background:var(--green)}
header{display:flex;justify-content:space-between;align-items:center;padding:16px 5%;border-bottom:1px solid #ffffff18;gap:12px;flex-wrap:wrap}
.brand{font-weight:1000;letter-spacing:2px;color:var(--gold)}.top-actions{display:flex;gap:8px;flex-wrap:wrap}
main{max-width:1100px;margin:auto;padding:28px 20px 60px}.screen{display:none;animation:fade .35s ease}.screen.active{display:block}@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.hero{text-align:center;padding:55px 20px 35px}.eyebrow{color:var(--cyan);font-weight:900;letter-spacing:4px;text-transform:uppercase}.hero h1{font-size:clamp(2.5rem,8vw,5.6rem);line-height:.95;margin:15px 0;color:var(--gold);text-shadow:0 5px 0 #9b5a00,0 0 35px #ffc85755}.hero h2{font-size:clamp(1.1rem,3vw,1.8rem);margin:15px 0}.hero p{color:var(--muted);line-height:1.7}
.panel{background:linear-gradient(145deg,#172443,#0e172c);border:1px solid #ffffff20;border-radius:20px;padding:22px;box-shadow:0 15px 45px #0005;margin:16px 0}
.meta{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin:22px 0}.pill{padding:8px 13px;border-radius:999px;background:#ffffff12;border:1px solid #ffffff20;color:#dce8ff;font-size:.9rem}
.actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:22px}.scoreboard{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:18px 0}.team{padding:18px;border-radius:16px;background:#15213b;border:1px solid #ffffff25}.team.alpha{border-color:var(--cyan)}.team.beta{border-color:var(--pink)}.team h3{margin:0 0 8px}.score{font-size:2rem;font-weight:1000}.alpha .score{color:var(--cyan)}.beta .score{color:var(--pink)}
h2.section-title{font-size:clamp(1.6rem,4vw,2.4rem);color:var(--gold)}.sub{color:var(--muted);line-height:1.6}
.board{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}.board-head{font-weight:900;text-align:center;padding:12px 4px;border-radius:10px;background:#263858}.tile{min-height:78px;background:#172744;border:1px solid #496080;color:white;border-radius:12px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px}.tile strong{font-size:1.2rem;color:var(--gold)}.tile small{color:var(--muted)}.tile.done{background:#0d392f;border-color:#347f66;color:#8af0c4}.tile.done strong{color:#8af0c4}
.question-card{max-width:850px;margin:20px auto}.q-top{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;color:var(--muted)}.question{font-size:clamp(1.25rem,3vw,1.8rem);line-height:1.45;margin:24px 0}.options{display:grid;gap:10px}.option{background:#1b2b4a;color:white;text-align:left;border:1px solid #405477;padding:15px;border-radius:12px}.option.correct{background:#10513b;border-color:var(--green)}.option.wrong{background:#5b2036;border-color:var(--pink)}.feedback{padding:15px;border-radius:12px;background:#ffffff10;margin:16px 0;line-height:1.6}.timer{font-weight:900;color:var(--gold)}.field{display:flex;gap:8px;flex-wrap:wrap}.field input{flex:1;min-width:180px;background:#081326;color:white;border:1px solid #526583;padding:13px;border-radius:10px}
.hidden{display:none!important}.rule-list{line-height:1.8;color:#dce6fa}.rule-list li{margin:6px 0}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:14px}.mini-title{color:var(--cyan);font-weight:900}.outline-list{line-height:1.8}.win{text-align:center;padding:45px 15px}.trophy{font-size:5rem}.winner{font-size:clamp(2rem,7vw,4rem);color:var(--gold);font-weight:1000}
footer{text-align:center;padding:22px;color:#8090ad;font-size:.85rem;border-top:1px solid #ffffff15}
@media(max-width:650px){.board{grid-template-columns:repeat(3,minmax(0,1fr))}.board-head{display:none}.two-col{grid-template-columns:1fr}.scoreboard{grid-template-columns:1fr}.hero{padding-top:35px}}
@media print{header,.top-actions,button{display:none!important}body{background:white;color:#111}.panel{box-shadow:none;background:white;color:#111;border:1px solid #aaa}.screen{display:block!important;page-break-after:always}}
